# Copy this file to .env and fill in values as needed.
# Used by docker-compose.yml; backend/frontend also have their own .env.example files
# for running each service outside Docker.

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_marketing_studio?schema=public

# --- AI ---
# Leave empty to use the built-in MockAIService (no cost, realistic canned output).
# Set a real key to route content generation through the OpenAI API instead.
OPENAI_API_KEY=

# --- API ---
API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# --- Runtime ---
NODE_ENV=development
