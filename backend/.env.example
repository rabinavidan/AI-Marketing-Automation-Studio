# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_marketing_studio?schema=public"

# When set, the AI module binds OpenAIService (real OpenAI calls).
# When unset/empty, the AI module binds MockAIService (realistic templated demo output).
OPENAI_API_KEY=

# Port the Nest HTTP server listens on
PORT=4000

# Allowed CORS origin for the frontend (Next.js dev server)
CORS_ORIGIN=http://localhost:3000
